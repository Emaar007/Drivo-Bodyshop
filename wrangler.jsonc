{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "drivo-bodyshop-dashboard",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "drivo-bodyshop",
      // Replace with the id printed by: npx wrangler d1 create drivo-bodyshop
      "database_id": "fb962134-7b9e-4af9-8bd6-cd077e4e495d",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    // Every hour at :25, five minutes after the corporate portal refreshes its TSD extract: pulls it
    // (when the DRIVO_EXTRACT_TOKEN secret is set) and, at 07:25 New York time, builds the day's tasks.
    "crons": ["25 * * * *"]
  },
  "vars": {
    "DUE_SOON_DAYS": "3",
    "TIMEZONE": "America/New_York",
    // When "true" the Worker serves the anonymised data/sample.json instead of the D1 snapshot
    // (used before the first TSD push). Set to "false" in production.
    "USE_SAMPLE_DATA": "false",
    "ADMIN_EMAILS": "mohamed@drivo.com"
  },
  "observability": { "enabled": true }
  // Secrets (wrangler secret put ...): INGEST_TOKEN (for pushes to /api/ingest), SESSION_SECRET,
  // DRIVO_EXTRACT_TOKEN (corporate portal extract; the hourly pull). Optional var DRIVO_EXTRACT_URL.
}
