# Settings for the TSD -> dashboard puller.
# setup.sh copies this file to /etc/drivo-bodyshop-push.env (owner root, group drivo-push, mode 640).
# Fill in the values THERE, on the server. Never commit real values to git.
#
# The file is read by /bin/sh, so wrap any value that contains spaces, $, #, quotes or
# backslashes in single quotes, e.g. TSD_SQL_PASS='p@ss$word#1'

# ---- TSD database (Azure SQL). The server's public IP must be on the Azure SQL firewall. ----
TSD_SQL_SERVER=azure-sql-tsd-drivo.database.windows.net
TSD_SQL_DB=42295
# Prefer a read-only login from TSD. The script only ever runs SELECTs either way.
TSD_SQL_USER=tsddrivoadmin
TSD_SQL_PASS=CHANGE_ME

# ---- Dashboard (Cloudflare Worker) ----
# Base URL of the dashboard, no trailing slash, e.g. https://bodyshop.drivo.workers.dev
BODYSHOP_API=CHANGE_ME
# Must equal the Worker secret INGEST_TOKEN (set with: npx wrangler secret put INGEST_TOKEN).
BODYSHOP_INGEST_TOKEN=CHANGE_ME

# ---- Optional ----
# First pickup date to include (body shop rentals started in December 2025).
BODYSHOP_SINCE=2025-12-01
