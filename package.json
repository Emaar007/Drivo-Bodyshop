{
  "name": "drivo-bodyshop-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply drivo-bodyshop --local",
    "db:migrate:remote": "wrangler d1 migrations apply drivo-bodyshop --remote",
    "sample:build": "python3 -I scripts/tsd/make_sample.py .cache/payload.json data/sample.json",
    "tsd:fetch": "python3 -I scripts/tsd/push_bodyshop.py --out .cache/payload.json",
    "tsd:push:local": "python3 -I scripts/tsd/push_bodyshop.py --url http://localhost:5173 --token dev-token"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "hono": "^4.13.13",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/workers-types": "^5.20261019.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3"
  }
}
